# Data & secrets (AD-9) -- never committed
/data/
.env*

# Python bytecode artifacts from skill/analysis scripts -- never committed
__pycache__/
*.py[co]

# Obsidian's own workspace config -- tool state, not vault content
.obsidian/

# LaTeX build artifacts (scoped to manuscript/ so they can't accidentally
# catch e.g. future analysis/outputs/ log files)
manuscript/**/*.aux
manuscript/**/*.bbl
manuscript/**/*.bcf
manuscript/**/*.bcf-SAVE-ERROR
manuscript/**/*.blg
manuscript/**/*.fdb_latexmk
manuscript/**/*.fls
manuscript/**/*.log
manuscript/**/*.out
manuscript/**/*.run.xml
manuscript/**/*.synctex.gz
manuscript/**/*.toc
manuscript/**/*.nav
manuscript/**/*.snm
manuscript/**/*.vrb
manuscript/**/*.idx
manuscript/**/*.ind
manuscript/**/*.ilg
manuscript/**/*.lof
manuscript/**/*.lot
manuscript/**/*.glo
manuscript/**/*.gls
manuscript/**/*.glg

# Compiled manuscript output -- source-of-truth is the .tex, not the PDF
manuscript/**/*.pdf

# LaTeX build artifacts for Beamer decks -- same list as manuscript/ above,
# scoped to presentations/ for the same reason (latex-presentation decks).
presentations/**/*.aux
presentations/**/*.bbl
presentations/**/*.bcf
presentations/**/*.blg
presentations/**/*.fdb_latexmk
presentations/**/*.fls
presentations/**/*.log
presentations/**/*.out
presentations/**/*.run.xml
presentations/**/*.synctex.gz
presentations/**/*.toc
presentations/**/*.nav
presentations/**/*.snm
presentations/**/*.vrb
presentations/**/*.idx
presentations/**/*.ind
presentations/**/*.ilg
presentations/**/*.lof
presentations/**/*.lot
presentations/**/*.glo
presentations/**/*.gls
presentations/**/*.glg

# Compiled deck output -- source-of-truth is the .tex, not the PDF
presentations/**/*.pdf
